VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

# Google reCAPTCHA v2 ("I'm not a robot") site key. PUBLIC — safe in the client.
VITE_RECAPTCHA_SITE_KEY=6Lfv8SAtAAAAABXAJaw5qjMXY8BXDKN1sn6HUk73
# Google reCAPTCHA v3 site key used by Firebase App Check. PUBLIC — safe here.
VITE_RECAPTCHA_V3_SITE_KEY=6Ldb-yAtAAAAAGNep5-U-umjrdTucKlS6m_bH8Ni
# NOTE: the reCAPTCHA SECRET keys (v2 and v3) are server-side only. Never add
# them as VITE_ variables or commit them. The v3 secret is pasted into the
# Firebase App Check console; the v2 secret would be used by a backend verify
# endpoint (e.g. a Cloud Function) against Google's siteverify endpoint.

# PostHog product analytics (public, client-side). Leave blank to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking (public DSN, client-side). Leave blank to disable.
VITE_SENTRY_DSN=

# Sentry source-map upload — BUILD-ONLY, never commit a real token. These are
# NOT VITE_ vars (they must not reach the client). Set them only in your build/CI
# environment; without them the app still builds, just with minified stack traces.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
