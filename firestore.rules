rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isOptionalCount(data, field) {
      return !(field in data) || (data[field] is number && data[field] >= 0);
    }

    function isOptionalShortString(data, field) {
      return !(field in data) || (data[field] is string && data[field].size() <= 16);
    }

    function isAudioSettings(value) {
      return value is map
        && value.keys().hasOnly(['soundEnabled', 'soundVolume'])
        && value.keys().hasAll(['soundEnabled', 'soundVolume'])
        && value.soundEnabled is bool
        && value.soundVolume is number
        && value.soundVolume >= 0
        && value.soundVolume <= 100;
    }

    function isUserProfile() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'username',
          'email',
          'coins',
          'selectedPastryId',
          'unlockedPastryIds',
          'audioSettings',
          'localStorageMigrated',
          'streakCount',
          'streakLongest',
          'streakLastActiveDate',
          'streakFreezes',
          'usernameChangedAt',
          'dailyGoalMinutes',
          'dailyGoalRewardedDate',
          'createdAt',
          'updatedAt'
        ])
        && data.username is string
        && data.username.size() > 0
        && data.username.size() <= 32
        && data.email is string
        && data.email.size() <= 120
        && data.coins is number
        && data.coins >= 0
        && data.selectedPastryId is string
        && data.selectedPastryId.size() > 0
        && data.selectedPastryId.size() <= 64
        && data.unlockedPastryIds is list
        && data.unlockedPastryIds.size() > 0
        && data.unlockedPastryIds.size() <= 32
        && isAudioSettings(data.audioSettings)
        && data.localStorageMigrated is bool
        && isOptionalCount(data, 'streakCount')
        && isOptionalCount(data, 'streakLongest')
        && isOptionalCount(data, 'streakFreezes')
        && isOptionalShortString(data, 'streakLastActiveDate')
        && isOptionalTimestamp(data, 'usernameChangedAt')
        && (!('dailyGoalMinutes' in data)
          || (data.dailyGoalMinutes is number
            && data.dailyGoalMinutes >= 10
            && data.dailyGoalMinutes <= 600))
        && isOptionalShortString(data, 'dailyGoalRewardedDate')
        && isOptionalTimestamp(data, 'createdAt')
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isStudySession() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'pastryId',
          'pastryName',
          'tagId',
          'tagName',
          'tagColor',
          'durationMinutes',
          'startedAt',
          'endedAt',
          'completed',
          'expired',
          'platform',
          'createdAt'
        ])
        && data.pastryId is string
        && data.pastryId.size() > 0
        && data.pastryId.size() <= 64
        && data.pastryName is string
        && data.pastryName.size() > 0
        && data.pastryName.size() <= 48
        && data.tagId is string
        && data.tagId.size() > 0
        && data.tagId.size() <= 80
        && data.tagName is string
        && data.tagName.size() > 0
        && data.tagName.size() <= 24
        && data.tagColor is string
        && data.tagColor.size() <= 16
        && data.durationMinutes is number
        && data.durationMinutes >= 10
        && data.durationMinutes <= 120
        && data.startedAt is string
        && data.startedAt.size() > 0
        && data.startedAt.size() <= 40
        && data.endedAt is string
        && data.endedAt.size() > 0
        && data.endedAt.size() <= 40
        && data.completed is bool
        && data.expired is bool
        && data.platform in ['web', 'android']
        && isOptionalTimestamp(data, 'createdAt');
    }

    function isFriendRequest() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'fromUid',
          'fromUsername',
          'toUid',
          'toUsername',
          'status',
          'createdAt'
        ])
        && data.fromUid is string
        && data.fromUid.size() <= 128
        && data.toUid is string
        && data.toUid.size() <= 128
        && data.fromUsername is string
        && data.fromUsername.size() <= 32
        && data.toUsername is string
        && data.toUsername.size() <= 32
        && data.status in ['pending', 'accepted']
        && isOptionalTimestamp(data, 'createdAt');
    }

    // True when the signed-in user has an *accepted* friend link with ownerUid,
    // in either direction. Used to gate reads of a user's leaderboard entry to
    // confirmed friends only. Short-circuits so at most 2 lookups run.
    function isAcceptedFriend(ownerUid) {
      let viewer = request.auth.uid;
      let forward =
        /databases/$(database)/documents/friendRequests/$(viewer + '__' + ownerUid);
      let backward =
        /databases/$(database)/documents/friendRequests/$(ownerUid + '__' + viewer);

      return (exists(forward) && get(forward).data.status == 'accepted')
        || (exists(backward) && get(backward).data.status == 'accepted');
    }

    function isLeaderboardStats() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'username',
          'weeklyMinutes',
          'weekKey',
          'totalMinutes',
          'streakCount',
          'updatedAt'
        ])
        && data.username is string
        && data.username.size() > 0
        && data.username.size() <= 32
        && data.weeklyMinutes is number
        && data.weeklyMinutes >= 0
        && data.weekKey is string
        && data.weekKey.size() <= 10
        && data.totalMinutes is number
        && data.totalMinutes >= 0
        && data.streakCount is number
        && data.streakCount >= 0
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isStudyTag() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'name',
          'color',
          'isDefault',
          'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 24
        && data.color is string
        && data.color.size() <= 16
        && data.isDefault is bool
        && isOptionalTimestamp(data, 'createdAt');
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isUserProfile();
      allow delete: if isOwner(uid);

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isStudySession();
        allow delete: if isOwner(uid);
      }

      match /tags/{tagId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isStudyTag();
        allow delete: if isOwner(uid);
      }
    }

    // Global username registry: one doc per lowercase name, holding the owner
    // uid. Create-only (no update) so claiming a name another user already holds
    // is denied atomically at the database — guaranteeing uniqueness. Owners may
    // release their own claim when switching names.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Friend relationships: one doc per direction, id "<from>__<to>". Either
    // party can read/delete; only the sender creates a pending request; only the
    // recipient may flip it to accepted (and nothing else).
    match /friendRequests/{id} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && isFriendRequest();
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // Public-to-friends leaderboard entries, keyed by uid. Any signed-in user can
    // `get` a specific entry (friends read each other's by known uid) but the
    // collection cannot be listed/enumerated. Only the owner writes their own.
    match /leaderboardStats/{uid} {
      // Only the owner or a confirmed friend may read an entry (and never list).
      allow get: if request.auth != null
        && (request.auth.uid == uid || isAcceptedFriend(uid));
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isLeaderboardStats();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
